FROM python:3.11-slim

# Prevent python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080

WORKDIR /app

# Install system dependencies: curl (healthcheck), iverilog (simulation), verilator (lint, and the
# verification simulator in api/verilator_sim.py: it builds C++, so make), yosys (synthesis, formal),
# z3 (formal solver, and Verilator's randomize() constraints), ghdl (VHDL), nextpnr-ice40 (place & route).
# Place & route targets the HX8K only (api/routes/synthesize.py): the other chip databases (137 MB) go.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    iverilog \
    verilator \
    make \
    yosys \
    z3 \
    ghdl \
    nextpnr-ice40 \
    coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && find /usr/share/nextpnr/ice40 -name 'chipdb-*.bin' ! -name 'chipdb-8k.bin' -delete

# Verible (chipsalliance): SystemVerilog style lint + formatter for api/routes/style.py.
# Pinned release, checked against its published sha256; only the two tools are kept.
ARG VERIBLE_VERSION=v0.0-4296-g0f262651
ARG VERIBLE_SHA256=8569defb891d2316067613ea00442af28a7a09d405d95b54c0c91f9942d26635
RUN curl -fsSL -o /tmp/verible.tgz \
      "https://github.com/chipsalliance/verible/releases/download/${VERIBLE_VERSION}/verible-${VERIBLE_VERSION}-linux-static-x86_64.tar.gz" \
    && echo "${VERIBLE_SHA256}  /tmp/verible.tgz" | sha256sum -c - \
    && tar -xzf /tmp/verible.tgz -C /tmp \
    && install -m 755 /tmp/verible-${VERIBLE_VERSION}/bin/verible-verilog-lint \
                      /tmp/verible-${VERIBLE_VERSION}/bin/verible-verilog-format /usr/local/bin/ \
    && rm -rf /tmp/verible.tgz /tmp/verible-${VERIBLE_VERSION}

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod 755 /usr/local/bin/entrypoint.sh

# Copy the API source code
COPY api/ /app/api/

# Copy the environment file to working directory root if it exists
RUN cp /app/api/.env /app/.env || true



# Port the API listens on inside the compose network
EXPOSE 8080

# Run the API server — shell form so ${PORT} expands correctly
CMD ["sh", "-c", "python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
